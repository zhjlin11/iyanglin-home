# ==============================================================================
# 杨林生活网 (iyanglin.com) - Git 属性与换行符规范
# 统一在 Windows 和 Linux 环境下使用 LF 换行符，避免部署和构建差异
# ==============================================================================

# 默认所有文本文件使用 LF
* text=auto eol=lf

# 明确的源码文件使用 LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.prisma text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf

# Windows 脚本文件保持 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
