// ==========================================
// 虚拟代币与钱包余额体系 (杨林金币)
// ==========================================

model CoinWallet {
  id             String            @id @default(cuid())
  userId         String            @unique
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance        Int               @default(0) // 金币余额 (1元 = 10金币)
  totalRecharged Int               @default(0) // 累计充值金币
  totalSpent     Int               @default(0) // 累计消费金币
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  transactions   CoinTransaction[]
}

model CoinTransaction {
  id            String     @id @default(cuid())
  walletId      String
  wallet        CoinWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount        Int // 正数 = 获得/充值, 负数 = 消耗/扣费
  type          String // RECHARGE=微信充值 | CHECKIN_GIFT=签到赠币 | POST_FEE=发帖扣费 | PIN_FEE=置顶扣费 | REFRESH_FEE=刷新扣费 | VIP_BUY=购买会员 | ADMIN_GRANT=管理员赠送
  orderNo       String?    // 关联的充值或支付订单号
  remark        String
  balanceBefore Int        @default(0)
  balanceAfter  Int        @default(0)
  businessType  String?    // PUBLISH | TOP | REFRESH | RECHARGE | REFUND
  businessId    String?    // 业务实体 ID (如 Job ID / Order ID)
  createdAt     DateTime   @default(now())

  @@index([walletId, createdAt])
}

// ==========================================
