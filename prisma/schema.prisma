// 消息发送日志
model WechatMessageLog {
  id         String   @id @default(cuid())
  openId     String
  userId     String?
  msgType    String // TEMPLATE=模板消息 | CUSTOM=客服消息 | AUTO_REPLY=自动回复
  templateId String? // 使用的模板ID
  scene      String? // 通知场景
  content    String? // 发送内容摘要
  status     String   @default("SENT") // SENT=已发送 | FAILED=失败 | BLOCKED=被屏蔽
  errorCode  Int? // 微信错误码
  errorMsg   String? // 微信错误信息
  retryCount Int      @default(0)
  sentAt     DateTime @default(now())

  @@index([openId])
  @@index([status])
  @@index([sentAt])
  @@index([scene])
}

// 消息幂等（防重复处理微信消息）
model WechatMsgIdempotent {
  msgId     String   @id // 微信消息MsgId
  openId    String
  processed Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// 欢迎流程（关注后多步骤消息编排）
model WelcomeFlow {
  id          String            @id @default(cuid())
  name        String // 流程名称，如"默认欢迎流程"、"招聘渠道流程"
  scene       String?           @unique // 关联渠道场景值，null=默认流程
  description String?
  enabled     Boolean           @default(true)
  isDefault   Boolean           @default(false) // 是否为默认欢迎流程
  priority    Int               @default(0) // 优先级，值越大越优先
  steps       WelcomeFlowStep[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([enabled, isDefault])
  @@index([scene])
}

// 欢迎流程步骤
model WelcomeFlowStep {
  id          String      @id @default(cuid())
  flowId      String
  flow        WelcomeFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  order       Int         @default(0) // 发送顺序
  type        String // TEXT, NEWS, IMAGE, LINK
  // TEXT 字段
  content     String?     @db.Text // 文本内容（支持<a>标签）
  // NEWS 图文字段
  title       String?
  description String?
  imageUrl    String? // 封面图URL
  linkUrl     String? // 点击跳转URL
  // IMAGE 字段
  mediaId     String? // 微信素材mediaId
  // 通用
  enabled     Boolean     @default(true)
  delayMs     Int         @default(0) // 发送延迟毫秒（受微信接口限制）
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([flowId, order])
}

// Login identities are separate from the platform member record. This table
// already exists in production and is the compatibility bridge for old users.
model AuthAccount {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // PASSWORD | PHONE | WECHAT | ADMIN
  providerAccountId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?

  @@unique([userId, provider])
  @@index([provider, providerAccountId])
  @@index([userId])
}

// Canonical WeChat identity. Legacy User.wechat* fields remain during the
// compatibility period and are dual-written by the account service.
model WechatAccount {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId         String
  openId        String
  unionId       String?
  nickname      String?
  avatarUrl     String?
  subscribed    Boolean   @default(false)
  subscribeAt   DateTime?
  unsubscribeAt DateTime?
  boundAt       DateTime  @default(now())
  lastSyncAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([appId, openId])
  @@index([userId])
  @@index([unionId])
}

// Append-only login audit trail.
model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider  String
  ip        String?
  userAgent String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ==========================================
// 园区招商 / 工业地产 (Industrial Property)
// ==========================================

enum IndustrialPropertyType {
  FACTORY             // 厂房
  WAREHOUSE           // 仓库
  LAND                // 土地 / 地皮
  OFFICE              // 办公楼
  INDUSTRIAL_PARK     // 产业园物业
  COMMERCIAL_SUPPORT  // 园区商业配套
  OTHER               // 其他
}

enum IndustrialTransactionType {
  RENT                // 出租
  SALE                // 出售
  TRANSFER            // 转让
  COOPERATION         // 合作
  JOINT_OPERATION     // 联营
  WANTED_RENT         // 求租
  WANTED_BUY          // 求购
}

enum IndustrialStatus {
  DRAFT               // 草稿
  PENDING             // 待审核
  PUBLISHED           // 已发布
  REJECTED            // 审核失败
  OFFLINE             // 已下架
  EXPIRED             // 已过期
}

enum IndustrialVerifiedLevel {
  NONE                // 普通发布
  PHONE_VERIFIED      // 电话已核验
  OWNER_VERIFIED      // 业主已核验
  ENTERPRISE_VERIFIED // 企业已认证
}

model IndustrialProperty {
  id                        String                    @id @default(cuid())
  userId                    String?
  user                      User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // 核心信息
  title                     String
  description               String
  propertyType              IndustrialPropertyType    @default(FACTORY)
  transactionType           IndustrialTransactionType @default(RENT)
  status                    IndustrialStatus          @default(PUBLISHED)
  rejectReason              String?

  // 区域与园区
  region                    String                    @default("杨林经开区")
  parkName                  String?
  address                   String
  latitude                  Float?
  longitude                 Float?

  // 面积指标 (㎡ 或 亩)
  buildingArea              Float?
  factoryArea               Float?
  landArea                  Float?
  officeArea                Float?

  // 商务与价格
  rentPrice                 Float?
  salePrice                 Float?
  priceUnit                 String                    @default("元/㎡/月")
  negotiable                Boolean                   @default(false)

  // 厂房 / 仓库工程技术参数
  floorHeight               Float?
  floorCount                Int?                      @default(1)
  isSingleFloor             Boolean                   @default(true)
  loadBearing               Float?
  columnSpacing             String?
  powerCapacity             Int?
  hasCrane                  Boolean                   @default(false)
  craneTonnage              Float?

  // 环保与基础设施
  hasGas                    Boolean                   @default(false)
  hasWater                  Boolean                   @default(true)
  hasDrainage               Boolean                   @default(true)
  hasFireSystem             Boolean                   @default(true)
  fireStatus                String?                   @default("丙类")
  hasEnvironmentalCondition Boolean                   @default(false)

  // 交通与物流装卸
  truckAccessible           Boolean                   @default(true)
  maxTruckLength            String?                   @default("17.5米")
  roadWidth                 Float?
  hasLoadingDock            Boolean                   @default(false)

  // 配套设施
  hasOffice                 Boolean                   @default(false)
  hasDormitory              Boolean                   @default(false)
  hasCanteen                Boolean                   @default(false)
  hasParking                Boolean                   @default(true)
  parkingCount              Int?

  // 土地地皮专有属性
  landUseType               String?
  propertyRightStatus       String?
  canSplit                  Boolean                   @default(false)
  canBuild                  Boolean                   @default(true)

  // 招商合作与商务条款
  cooperationDemand         String?
  minimumLeaseTerm          String?                   @default("1年")
  availableDate             String?                   @default("随时可进驻")
  suitableIndustries        String[]                  @default([])

  // 联系人与认证体系
  contactName               String
  contactPhone              String
  verifiedLevel             IndustrialVerifiedLevel   @default(NONE)

  // 运营指标
  featured                  Boolean                   @default(false)
  isTop                     Boolean                   @default(false)
  topUntil                  DateTime?

  viewCount                 Int                       @default(0)
  favoriteCount             Int                       @default(0)

  // 多媒体
  images                    String[]                  @default([])

  // 时间
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  publishedAt               DateTime                  @default(now())

  @@index([propertyType])
  @@index([transactionType])
  @@index([region])
  @@index([status])
  @@index([isTop, createdAt])
}

// ==========================================
// 便民信息 P1 商业化推广与服务生态模型
// ==========================================

model ListingPromotion {
  id             String      @id @default(cuid())
  orderNo        String      @unique
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceType   String      @default("LISTING")
  resourceId     String
  listing        Listing     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  promotionType  String      // TOP_3_DAYS | TOP_7_DAYS | CATEGORY_FEATURED | HOME_FEATURED
  amountCents    Int
  status         String      @default("PENDING_PAYMENT") // PENDING_PAYMENT | ACTIVE | EXPIRED | CANCELLED | REFUNDED
  source         String      @default("PAID") // PAID (自费) | ADMIN (人工赠送/置顶)
  startAt        DateTime?
  endAt          DateTime?
  paymentOrderId String?     // 关联 BillingOrder.id
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([resourceId, status])
  @@index([userId])
  @@index([status, endAt])
}

model ServiceProvider {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String    // 个人真实姓名或店铺企业名称
  avatar             String?   // 个人头像或门店门头 Logo
  serviceCategory    String    // 主营类别 (家政维修/电脑数码/特色餐饮/商务财税/技能培训等)
  serviceAreas       String[]  @default([]) // 覆盖服务区域 (如 杨林经开区, 杨林大学城)
  phone              String    // 服务热线/手机号
  wechat             String?   // 微信号
  yearsOfService     String?   // 从业年限 (如 "5年经验")
  address            String?   // 公开经营地址 / 门店位置
  intro              String    // 服务介绍与专业特长
  licenseImages      String[]  @default([]) // 营业执照或资格证书实拍
  verificationType   String    @default("SERVICE_VERIFIED") // PHONE_VERIFIED | REAL_NAME_VERIFIED | MERCHANT_VERIFIED | SERVICE_VERIFIED | ENTERPRISE_VERIFIED
  verificationStatus String    @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED
  rejectReason       String?   // 驳回说明
  verifiedAt         DateTime?
  validUntil         DateTime? // 认证有效期
  reviewerId         String?
  isMember           Boolean   @default(false) // 商家会员
  memberUntil        DateTime?
  sortOrder          Int       @default(0)
  operatingStatus    String    @default("OPEN") // OPEN (接单中) | BUSY (稍忙) | PAUSED (暂停接单)
  businessHours      String?   @default("08:00 - 20:00")
  ratingAvg          Float     @default(5.0)
  ratingCount        Int       @default(0)
  completedOrders    Int       @default(0)
  assignedRequests   ServiceRequest[] @relation("ProviderAssignedRequests")
  leads              ServiceLead[]
  reviews            Review[]
  contactEvents      ContactEvent[]
  coupons            ServiceCoupon[]
  commissionRate     Float?    // 商家专属特殊抽佣比例 (如 0.06 即 6%)
  pendingBalance     Int       @default(0) // 在途履约冻结资金 (分)
  availableBalance   Int       @default(0) // 可申请结算提现资金 (分)
  settledAmount      Int       @default(0) // 历史累计已结算出金 (分)
  products           ServiceProduct[]
  serviceOrders      ServiceOrder[]   @relation("ProviderServiceOrders")
  settlements        Settlement[]
  followers          FollowProvider[]
  campaigns          MerchantCampaign[]
  customerNotes      ProviderCustomerNote[]
  organizations      Organization[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([serviceCategory, verificationStatus])
  @@index([verificationStatus])
  @@index([operatingStatus])
}

model PromotionPackage {
  id                 String   @id @default(cuid())
  packageKey         String   @unique // TOP_3_DAYS | TOP_7_DAYS | CATEGORY_FEATURED | HOME_FEATURED | MERCHANT_BADGE | MEMBER_PLAN
  name               String   // 3天分类置顶 | 7天分类置顶 | 分类精选推荐 | 首页大厅推荐 | 商家认证年费 | 商家会员月包
  category           String   // PROMOTION | VERIFICATION | MEMBERSHIP
  priceCents         Int      // 价格(分)
  originalPriceCents Int?     // 划线原价(分)
  durationDays       Int      // 有效期(天)
  benefits           String[] // 权益点: ["分类列表顶部展示", "专属金黄色高亮标牌", "优先曝光"]
  description        String?
  enabled            Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ==========================================
// 便民信息 P2 本地需求撮合 + 服务线索 + 商家经营工具
// ==========================================

model ServiceRequest {
  id                 String            @id @default(cuid())
  requestNo          String            @unique // e.g. REQ-20260913-XXXX
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String            // 需求标题，如 "大学城怡园急需修下水管漏水"
  category           String            // 家电维修 | 管道疏通 | 开锁换锁 | 家政保洁 | 房屋修缮 | 搬家拉货 | 数码电脑 | 便民跑腿 | 其它
  area               String            // 杨林大学城 | 杨林经开区 | 杨林老城区 | 职教园区 | 嘉丽泽 | 杨林全区
  addressDetail      String?           // 具体地点/小区（保护隐私，仅接单服务商可见）
  budgetMin          Int?              // 最低预算(分)
  budgetMax          Int?              // 最高预算(分)
  preferredTime      String            // 尽快上门 | 今天内 | 明天 | 周末 | 电话沟通协商
  urgency            String            @default("NORMAL") // URGENT (加急) | NORMAL (正常) | FLEXIBLE (灵活)
  description        String            // 详细故障/需求描述
  images             String[]          @default([])
  contactName        String            // 客户称呼，如 "张先生"
  contactPhone       String            // 联系手机号
  contactWechat      String?           // 微信号
  status             String            @default("PENDING_MATCH") // PENDING_MATCH | MATCHED | IN_PROGRESS | COMPLETED | CANCELLED | EXPIRED
  cancelReason       String?
  selectedProviderId String?
  selectedProvider   ServiceProvider?  @relation("ProviderAssignedRequests", fields: [selectedProviderId], references: [id], onDelete: SetNull)
  leads              ServiceLead[]
  contactEvents      ContactEvent[]
  review             Review?
  serviceOrder       ServiceOrder?
  expiresAt          DateTime          // 默认发布后 15 天
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([category, status])
  @@index([area, status])
  @@index([userId, status])
  @@index([status, createdAt])
}

model ServiceLead {
  id             String          @id @default(cuid())
  requestId      String
  request        ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerId     String
  provider       ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  status         String          @default("NEW") // NEW (新匹配) | VIEWED (已查看) | CONTACTED (已联系) | ACCEPTED (已接单) | DECLINED (谢绝) | COMPLETED (已完成)
  isUnlocked     Boolean         @default(false) // 是否已解锁查看完整脱敏电话
  unlockedAt     DateTime?
  viewedAt       DateTime?
  contactedAt    DateTime?
  acceptedAt     DateTime?
  completedAt    DateTime?
  notes          String?         // 商家内部跟进备注
  stage          String          @default("NEW") // NEW | CONTACTED | FOLLOWING | WON | LOST
  nextFollowAt   DateTime?
  followUps      LeadFollowUp[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([requestId, providerId])
  @@index([providerId, status])
  @@index([requestId])
}

model ContactEvent {
  id           String           @id @default(cuid())
  userId       String?
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  providerId   String?
  provider     ServiceProvider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  requestId    String?
  request      ServiceRequest?  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  listingId    String?
  listing      Listing?         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  action       String           // CALL (点击拨打电话) | COPY_PHONE (复制电话) | COPY_WECHAT (复制微信) | CLICK_CONSULT (咨询联系) | VIEW_PROFILE (查看主页)
  source       String           @default("REQUEST_DETAIL") // REQUEST_MATCH | REQUEST_DETAIL | PROVIDER_PROFILE | PROVIDER_CENTER | INFO_DETAIL
  ip           String?
  userAgent    String?
  createdAt    DateTime         @default(now())

  @@index([providerId, action, createdAt])
  @@index([requestId, action])
  @@index([listingId, action])
  @@index([createdAt])
}

model Review {
  id           String          @id @default(cuid())
  requestId    String?         @unique // P2 需求单关联 (一单只能评价一次)
  request      ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  orderId      String?         @unique // P3 交易订单关联 (一单只能评价一次)
  order        ServiceOrder?   @relation("OrderReview", fields: [orderId], references: [id], onDelete: Cascade)
  providerId   String
  provider     ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating       Int             // 1 - 5 星
  tags         String[]        @default([]) // 响应迅速、准时上门、收费合理、技术专业等
  content      String          // 真实评价内容 (5-500字)
  images       String[]        @default([]) // 完工实拍图
  status       String          @default("APPROVED") // APPROVED (正常展示) | PENDING (审核中) | HIDDEN (已隐藏)
  replyContent String?         // 服务商回复
  replyAt      DateTime?       // 服务商回复时间
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([providerId, status, createdAt])
  @@index([userId])
}

model ServiceCoupon {
  id                  String           @id @default(cuid())
  providerId          String?          // null 则为平台通用券
  provider            ServiceProvider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title               String           // 如 "新客上门立减券", "杨林生活节·全场立减10元"
  issuerType          String           @default("PROVIDER") // PROVIDER (商家券) | PLATFORM (平台券)
  couponType          String           @default("FIXED") // FIXED (满减券) | DISCOUNT (折扣券) | NEW_USER (新客券) | REPEAT (复购券)
  discountCents       Int              // 减免金额(分)，如 2000 (20元)
  valueCents          Int              @default(0) // 立减分，或折扣比例 (如 85 代表 8.5折)
  maxDiscountCents    Int?             // 折扣券封顶优惠(分)
  minSpendCents       Int              @default(0) // 最低消费门槛(分)，如 5000 (满50元)
  applicableScope     String           @default("ALL") // ALL (全场/全品类) | CATEGORY (指定品类) | PRODUCT (指定服务商品)
  applicableCategory  String?          // 适用分类 (如 "家电维修")
  applicableProductId String?          // 适用具体单品
  totalQuantity       Int              @default(100) // 发放总量
  receivedQuantity    Int              @default(0) // 已领数量
  usedQuantity        Int              @default(0) // 已核销数量
  perUserLimit        Int              @default(1) // 每人限领张数
  validDays           Int              @default(30)
  startAt             DateTime?
  endAt               DateTime?
  description         String?
  enabled             Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  userCoupons         UserCoupon[]

  @@index([providerId, enabled])
  @@index([issuerType, enabled])
  @@index([couponType, enabled])
}

// 用户领取的优惠券
model UserCoupon {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId       String
  coupon         ServiceCoupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  status         String         @default("AVAILABLE") // AVAILABLE (可使用) | USED (已使用) | EXPIRED (已过期)
  receivedAt     DateTime       @default(now())
  expiresAt      DateTime
  usedAt         DateTime?
  usedOrderId    String?
  usedOrder      ServiceOrder?  @relation("OrderUsedCoupons", fields: [usedOrderId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId, status])
  @@index([couponId, status])
  @@index([usedOrderId])
}

// 关注服务商 (区别于收藏单条信息)
model FollowProvider {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId     String
  provider       ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())

  @@unique([userId, providerId])
  @@index([providerId])
  @@index([userId])
}

// 店铺营销活动 (开学季、换季保养、老客特惠等)
model MerchantCampaign {
  id             String          @id @default(cuid())
  providerId     String
  provider       ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title          String          // 活动标题，如 "开学季·大学城数码维修特惠"
  subtitle       String?         // 副标题，如 "凭学生证再减10元"
  badgeText      String?         // 角标，如 "限时特惠" | "老客专享" | "开学季"
  bannerImage    String?         // 活动海报图
  content        String          // 活动详情与细则
  discountRate   Float?          // 折扣比例，如 0.85
  discountCents  Int?            // 立减分，如 2000
  couponId       String?         // 关联的优惠券ID
  startAt        DateTime
  endAt          DateTime
  status         String          @default("ACTIVE") // ACTIVE | PENDING_REVIEW | ENDED | REJECTED
  rejectReason   String?
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([providerId, status])
  @@index([status, endAt])
}

// 用户偏好与轻量推荐
model UserPreference {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredCategories      String[] @default([]) // 常用偏好分类，如 ["家电维修", "管道疏通"]
  preferredArea            String?  // 常住片区，如 "杨林大学城"
  notifyOnFollowNewProduct Boolean  @default(true) // 关注商家发布新服务通知
  notifyOnFollowCampaign   Boolean  @default(true) // 关注商家新活动通知
  notifyOnCouponExpiring   Boolean  @default(true) // 优惠券即将过期提醒
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// 商家 CRM 客户画像、内部标签与回访提醒 (数据严格租户隔离)
model ProviderCustomerNote {
  id                String          @id @default(cuid())
  providerId        String
  provider          ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customerId        String          // 对应 User.id
  tags              String[]        @default([]) // 内部标签: ["老客户", "高频客户", "待回访", "企业客户", "品质挑剔", "已推荐朋友"]
  notes             String?         // 内部服务备忘与跟进日志
  nextFollowUpAt    DateTime?       // 下次保养/回访提醒日期
  followUpCompleted Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([providerId, customerId])
  @@index([providerId, nextFollowUpAt])
}

// ==========================================
// 便民信息 P3 本地服务在线交易平台模型
// ==========================================

// 用户服务地址
model UserAddress {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactName   String         // 联系人姓名
  phone         String         // 联系电话
  area          String         // 所属片区 (杨林大学城 | 杨林经开区 | 杨林老城区 | 嵩明主城区 | 职教园区)
  addressDetail String         // 详细门牌/小区地址 (接单前隐私保护)
  tag           String?        // 标签：家 | 公司 | 宿舍 | 其它
  isDefault     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        ServiceOrder[]

  @@index([userId, isDefault])
}

// 标准化服务商品
model ServiceProduct {
  id              String          @id @default(cuid())
  providerId      String
  provider        ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category        String          // 家电维修 | 管道疏通 | 开锁换锁 | 家政保洁 | 房屋修缮 | 搬家拉货 | 数码电脑 | 便民跑腿 | 其它
  title           String          // 服务标题，如 "空调挂机/柜机免拆深度蒸汽清洗"
  description     String          // 服务明细、作业流程与标准
  coverImage      String?         // 封面展示图
  images          String[]        @default([]) // 详情展示图
  pricingType     String          @default("FIXED") // FIXED (固定全款) | STARTING (起步预约定金) | HOURLY (小时工) | QUOTE (到场报价)
  priceCents      Int             // 基础价格/单价 (分，整数存储)
  minPriceCents   Int?            // 最低预估价 (分)
  maxPriceCents   Int?            // 最高预估价 (分)
  unit            String          @default("次") // 次 | 台 | 小时 | 米 | 间
  serviceDuration String?         // 预计耗时，如 "约1-2小时"
  serviceAreas    String[]        @default([]) // 覆盖服务片区
  bookingRequired Boolean         @default(true) // 是否需要预约时间
  status          String          @default("ONLINE") // ONLINE 上架 | OFFLINE 下架
  salesCount      Int             @default(0) // 累计销量/服务单数
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  orders          ServiceOrder[]

  @@index([providerId, status])
  @@index([category, status])
  @@index([status, sortOrder])
}

// 本地服务交易订单
model ServiceOrder {
  id                  String          @id @default(cuid())
  orderNo             String          @unique // e.g. SO20260913XXXXX
  userId              String
  user                User            @relation("CustomerServiceOrders", fields: [userId], references: [id], onDelete: Cascade)
  providerId          String
  provider            ServiceProvider @relation("ProviderServiceOrders", fields: [providerId], references: [id], onDelete: Cascade)
  productId           String?
  product             ServiceProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTitle        String          // 商品标题快照
  productPrice        Int             // 购买时单价快照 (分)
  pricingType         String          // 计价方式快照
  quantity            Int             @default(1)

  // 关联 P2 需求单 (若由需求撮合转化下单)
  requestId           String?         @unique
  request             ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  // 财务金额计算 (分，严禁使用浮点数 Float 存钱)
  totalAmountCents    Int             // 订单原价 (分)
  discountCents       Int             @default(0) // 优惠立减金额 (分)
  payAmountCents      Int             // 实际支付金额 (分)
  platformFeeCents    Int             @default(0) // 平台抽佣技术服务费 (分)
  providerIncomeCents Int             @default(0) // 商家预估可结收入 (分)
  commissionRate      Float           @default(0.10) // 该笔订单锁定的佣金率快照 (如 0.08 即 8%)

  // 状态流转机
  status              String          @default("PENDING_PAYMENT")
  // PENDING_PAYMENT | PAID | ACCEPTED | IN_SERVICE | WAITING_CONFIRM | COMPLETED | CANCELLED | REFUNDING | REFUNDED | DISPUTED | CLOSED
  paymentStatus       String          @default("UNPAID") // UNPAID | PAID | REFUNDED | PARTIAL_REFUNDED
  refundStatus        String          @default("NONE") // NONE | APPLIED | PROCESSING | REFUNDED | REJECTED

  // 服务履约与地址保护  // 技师指派履约 (P7)
  technicianId        String?
  technician          User?           @relation("TechnicianOrders", fields: [technicianId], references: [id], onDelete: SetNull)


  addressId           String?
  address             UserAddress?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  contactName         String          // 联系人姓名
  contactPhone        String          // 客户电话
  serviceArea         String          // 服务片区 (接单前公开展示给服务商)
  addressDetail       String          // 详细门牌地址 (接单后服务商可见，接单前隐私保护)
  appointmentAt       DateTime        // 预约上门服务时间
  userRemark          String?         // 客户下单留言备注
  providerNotes       String?         // 师傅内部跟进备注

  // 完工交付物
  completionNotes     String?         // 完工说明
  completionImages    String[]        @default([]) // 完工实拍照片

  // 全生命周期时间戳
  paidAt              DateTime?
  acceptedAt          DateTime?
  startedAt           DateTime?
  completedAt         DateTime?       // 师傅提交完工时间
  confirmedAt         DateTime?       // 客户确认完工 (或自动确认) 时间
  cancelledAt         DateTime?
  cancelReason        String?

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // 渠道来源归因与复购追踪 (P4)
  source              String          @default("DIRECT") // DIRECT | REPURCHASE | SEARCH | RECOMMENDED | FAVORITE | FOLLOW | COUPON | SHARE
  reorderFromId       String?         // 再次购买的原订单ID引用
  userCouponId        String?         // 关联核销的用户优惠券记录ID快照
  usedCoupons         UserCoupon[]    @relation("OrderUsedCoupons")

  // 关联模型
  settlement          Settlement?
  refunds             Refund[]
  afterSales          AfterSale[]
  review              Review?         @relation("OrderReview")

  @@index([technicianId, status])
  @@index([userId, status])
  @@index([providerId, status])
  @@index([status, createdAt])
  @@index([paymentStatus])
}

// 平台抽佣与商户结算单
model Settlement {
  id               String          @id @default(cuid())
  settlementNo     String          @unique // e.g. SET20260913XXXX
  orderId          String          @unique
  order            ServiceOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  providerId       String
  provider         ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  grossAmountCents Int             // 订单交易总额 (分)
  platformFeeCents Int             // 扣除平台技术服务费 (分)
  netAmountCents   Int             // 师傅实际净到手结算金额 (分)
  status           String          @default("PENDING") // PENDING (履约中冻结) | READY (完工待提现) | SETTLED (已出金到账) | HELD (纠纷冻结) | CANCELLED (退款作废)
  settledAt        DateTime?
  operatorId       String?         // 经办财务管理员 ID
  operatorName     String?
  payoutMethod     String?         // 结算方式: WECHAT_TRANSFER | BANK_TRANSFER | OFFLINE
  payoutProof      String?         // 出金流水单号 / 汇款水单
  remark           String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([providerId, status])
  @@index([status, createdAt])
}

// 交易退款模型
model Refund {
  id              String          @id @default(cuid())
  refundNo        String          @unique // e.g. RFD20260913XXXX
  orderId         String
  order           ServiceOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents     Int             // 退款金额 (分)
  reason          String          // 退款原因
  status          String          @default("REQUESTED") // REQUESTED | PROCESSING | SUCCESS | REJECTED | FAILED
  wechatRefundId  String?         // 微信退款单号
  wechatRefundFee Int?            // 微信退款实际到账分
  rejectReason    String?         // 驳回原因
  requestedAt     DateTime        @default(now())
  processedAt     DateTime?
  processedBy     String?         // 经办管理员 ID
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([orderId, status])
  @@index([userId])
}

// 售后纠纷与争议仲裁模型
model AfterSale {
  id                String          @id @default(cuid())
  orderId           String
  order             ServiceOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  applicantId       String
  applicant         User            @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  type              String          // 服务未完成 | 实际与描述不符 | 乱收费 | 质量差 | 态度恶劣 | 其它
  description       String          // 详细争议说明
  evidence          String[]        @default([]) // 实拍凭证照片
  status            String          @default("OPEN") // OPEN | UNDER_REVIEW | WAITING_PROVIDER | WAITING_USER | RESOLVED | CLOSED
  handledBy         String?         // 经办客服/仲裁员 ID
  result            String?         // 仲裁结论说明
  refundAmountCents Int?            // 仲裁退款金额 (分)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([orderId, status])
  @@index([applicantId])
}

// ==========================================
// P5: 平台统一认证记录模型
// ==========================================
model VerificationRecord {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifyType      String    // REAL_NAME | ENTERPRISE | MERCHANT | PROVIDER | LANDLORD
  idCardName      String?   // 真实姓名 / 法人姓名
  idCardNoMasked  String?   // 脱敏身份证号 (如 530124********1234)
  idCardPhotos    String[]  @default([])
  companyName     String?   // 企业/店铺注册名称
  licenseNo       String?   // 统一社会信用代码 / 营业执照注册号
  licensePhotos   String[]  @default([])
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED
  reviewerId      String?   // 审核管理员ID
  reviewerNote    String?   // 审核备注 / 驳回理由
  reviewedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, verifyType])
  @@index([status, createdAt])
}

// ==========================================
// P5: 平台轻量分析与行为埋点模型
// ==========================================
model AnalyticsEvent {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId    String?
  eventName    String    // VIEW | SEARCH | FAVORITE | CONTACT | ORDER | PAY | SHARE | REDEEM
  resourceType String?   // JOB | HOUSE | INDUSTRIAL | LISTING | SHOP | SERVICE_PRODUCT | POST | ARTICLE
  resourceId   String?
  channel      String?   // web_pc | web_mobile | wechat_h5
  metadata     Json?     // 结构化元数据（脱敏无敏感信息）
  createdAt    DateTime  @default(now())

  @@index([eventName, createdAt])
  @@index([resourceType, resourceId])
  @@index([userId, createdAt])
}

// ==========================================
// P6: 智能化平台模型 (AI / 自动化 / 运营机会)
// ==========================================

model AiUsageLog {
  id           String   @id @default(cuid())
  userId       String?
  scene        String   // CHAT | SEARCH_QUERY | CONTENT_ASSIST | MODERATION_ASSIST | BUSINESS_INSIGHT | CUSTOMER_SERVICE | ANALYTICS
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costCents    Float    @default(0)
  latencyMs    Int      @default(0)
  status       String   // SUCCESS | FAILED | FALLBACK
  errorMessage String?
  resourceType String?  // JOB | HOUSE | LISTING | SHOP | INDUSTRIAL | SERVICE_PRODUCT
  resourceId   String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([scene, createdAt])
  @@index([createdAt])
}

model AiConversation {
  id            String      @id @default(cuid())
  userId        String?
  title         String      @default("新对话")
  scene         String      @default("LIFESTYLE_ASSISTANT") // LIFESTYLE_ASSISTANT | CUSTOMER_SERVICE
  status        String      @default("ACTIVE") // ACTIVE | ARCHIVED
  lastMessageAt DateTime    @default(now())
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  messages      AiMessage[]

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastMessageAt])
  @@index([userId, createdAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String         // user | assistant | system
  content        String
  resourcesJson  String?        // 匹配到的真实业务卡片 JSON
  sourcesJson    String?        // 业务资源 JSON (统一规范)
  intentJson     String?        // 解析出的意图结构体 JSON
  metadataJson   String?        // 追问建议、状态元数据 JSON
  createdAt      DateTime       @default(now())

  conversation AiConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AutomationRule {
  id             String    @id @default(cuid())
  name           String
  triggerType    String    // FAVORITE_UNORDERED_3D | VIP_EXPIRE_7D | LISTING_EXPIRE_3D | NEW_DEMAND_MATCH | INACTIVE_USER_7D | INACTIVE_USER_30D
  conditionsJson String    @default("{}")
  actionType     String    // NOTIFICATION | TASK_REMINDER | COUPON_GRANT | OP_TAG | CUSTOMER_TASK
  actionPayload  String    @default("{}")
  enabled        Boolean   @default(true)
  executionCount Int       @default(0)
  lastRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  logs AutomationLog[]
}

model AutomationLog {
  id        String          @id @default(cuid())
  ruleId    String
  userId    String?
  action    String
  status    String          // SUCCESS | SKIPPED | FAILED
  result    String?
  createdAt DateTime        @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt])
  @@index([userId, createdAt])
}

model OperationOpportunity {
  id          String   @id @default(cuid())
  type        String   // SEARCH_GAP | SUPPLY_DEMAND_GAP | HIGH_PV_LOW_CONV | HIGH_FAV_NO_CONTACT | USER_CHURN
  title       String
  description String
  dataJson    String   @default("{}")
  priority    String   @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status      String   @default("PENDING") // PENDING | PROCESSED | IGNORED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, status])
  @@index([priority, createdAt])
}

model GrowthExperiment {
  id             String   @id @default(cuid())
  experimentKey  String   @unique
  name           String
  variantsJson   String   @default("[\"A\", \"B\"]")
  weightsJson    String   @default("{\"A\": 50, \"B\": 50}")
  status         String   @default("ACTIVE") // ACTIVE | PAUSED | CONCLUDED
  metricsJson    String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}



// =======================================================
// P7: 多端统一数字生活平台模型 (WechatIdentity, Organization, ATS, Task, Queue, QR)
// =======================================================

model WechatIdentity {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  appType       String    // OFFICIAL_ACCOUNT | MINI_PROGRAM
  appId         String
  openId        String
  unionId       String?
  subscribed    Boolean   @default(false)
  subscribeTime DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([appType, openId])
  @@index([userId])
  @@index([unionId])
  @@index([appType, appId])
}

model Organization {
  id            String               @id @default(cuid())
  name          String
  type          String               @default("ENTERPRISE") // ENTERPRISE | MERCHANT
  logo          String?
  intro         String?
  industry      String?
  address       String?
  contactName   String?
  contactPhone  String?
  ownerId       String
  owner         User                 @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  providerId    String?              // 若为商户/服务商，绑定 ServiceProvider.id
  provider      ServiceProvider?     @relation(fields: [providerId], references: [id], onDelete: SetNull)
  shopId        String?              // 若绑定 Shop.id
  status        String               @default("ACTIVE") // ACTIVE | DISABLED | PENDING
  riskFlag      Boolean              @default(false) // 风控标记
  canExport     Boolean              @default(false) // 是否具备客户/订单全量导出权限
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  members       OrganizationMember[]
  invites       OrganizationInvite[]
  auditLogs     OrganizationAuditLog[]
  tasks         OrganizationTask[]
  jobs          Job[]
  candidates    Candidate[]
  company       Company?
  qrCodes       UnifiedQrCode[]
  apiKeys       ApiKeyConfig[]
  webhooks      WebhookEndpoint[]

  @@index([ownerId])
  @@index([type, status])
  @@index([providerId])
}

// ==========================================
// 企业招聘主体档案 (Company)
// ==========================================

model Company {
  id                   String        @id @default(cuid())
  name                 String        @unique // 标准化企业全称
  shortName            String?       // 企业简称
  logo                 String?       // 企业Logo
  coverImage           String?       // 企业展示封面/横幅
  description          String?       // 企业深度图文/文本介绍
  industry             String?       // 所属行业: 如 工业制造、食品加工、商贸零售
  companySize          String?       @default("1-49人") // 1-49人 | 50-99人 | 100-499人 | 500-999人 | 1000人以上
  companyType          String?       @default("民营企业") // 国企 | 外企 | 民营企业 | 股份制 | 事业单位 | 个体工商户
  foundedYear          Int?          // 成立年份
  registeredCapital    String?       // 注册资本: 如 500万元人民币
  creditCode           String?       @unique // 统一社会信用代码 (18位)
  businessLicenseImage String?       // 营业执照原件图片 (仅后台管理与合规审核可见)
  legalRepresentative  String?       // 法定代表人 (仅后台/合规审核可见)
  contactName          String?       // 官方招聘联系人
  contactPhone         String?       // 官方联系电话 (脱敏后展示)
  contactWechat        String?       // 官方招聘微信号
  email                String?       // 企业电子邮箱
  website              String?       // 企业官方网站
  province             String?       @default("云南省")
  city                 String?       @default("昆明市")
  district             String?       @default("嵩明县")
  address              String?       // 企业办公/注册/厂区地址
  latitude             Float?        // 经度
  longitude            Float?        // 纬度

  // 认证与推荐流转状态
  isVerified           Boolean       @default(false)
  verificationStatus   String        @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  verificationLevel    String?       // 基础收录 | 工商执照核验 | 园区实地认证
  verifiedAt           DateTime?
  rejectReason         String?       // 认证驳回原因
  isFeaturedEmployer   Boolean       @default(false) // 名企招聘推荐 (与真实认证分离)

  // 状态与溯源
  status               String        @default("ACTIVE") // ACTIVE | DISABLED | ARCHIVED
  source               String        @default("MIGRATED") // ADMIN_CREATED | USER_CREATED | IMPORT | CLAIMED | MIGRATED
  createdBy            String?

  // 关联工作台 Organization (1:1 体系协同)
  organizationId       String?       @unique
  organization         Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  jobs                 Job[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([verificationStatus])
  @@index([isFeaturedEmployer])
  @@index([status])
  @@index([industry])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("OPERATOR") // OWNER | ADMIN | OPERATOR | HR | CUSTOMER_SERVICE | FINANCE | TECHNICIAN
  title          String?      // 职位头衔，例如 "高级技师"、"招聘经理"、"财务主管"
  status         String       @default("ACTIVE") // ACTIVE | DISABLED
  joinedAt       DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviteCode     String       @unique // 随机邀请码
  invitePhone    String?      // 指定邀请手机号 (可选)
  role           String       @default("OPERATOR")
  expiresAt      DateTime
  isUsed         Boolean      @default(false)
  usedByUserId   String?
  createdBy      String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([inviteCode])
}

model OrganizationAuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  operatorId     String
  operatorName   String
  action         String       // EXPORT_CUSTOMERS | EXPORT_ORDERS | UPDATE_MEMBER_ROLE | REMOVE_MEMBER | CHANGE_STATUS | ASSIGN_TECHNICIAN
  targetType     String?
  targetId       String?
  detailsJson    String       @default("{}")
  ip             String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([operatorId])
}

model Candidate {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeId       String
  resume         Resume               @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage          String               @default("APPLIED") // APPLIED | SCREENING | INTERVIEW | OFFER | HIRED | REJECTED
  rating         Int                  @default(0) // 1-5 星评分
  notes          String?              // HR/用人部门内部评语
  rejectedReason String?
  appliedAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  interviews     CandidateInterview[]

  @@unique([jobId, resumeId])
  @@index([organizationId, stage])
  @@index([userId])
  @@index([jobId])
}

model CandidateInterview {
  id            String    @id @default(cuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewTime DateTime
  location      String    // 面试地点或线上会议链接
  interviewer   String?   // 面试官姓名/称呼
  status        String    @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED | MISSED
  feedback      String?   // 面试评价反馈
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([candidateId])
  @@index([interviewTime])
}

model LeadFollowUp {
  id           String      @id @default(cuid())
  leadId       String
  lead         ServiceLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  operatorId   String
  operatorName String
  stage        String      // NEW | CONTACTED | FOLLOWING | WON | LOST
  content      String      // 跟进内容、客户反馈、报价意向
  nextFollowAt DateTime?   // 下次回访时间
  createdAt    DateTime    @default(now())

  @@index([leadId, createdAt])
}

model OrganizationTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assigneeId     String?
  assignee       User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  type           String       // LEAD_FOLLOW | AFTER_SALE | INTERVIEW | ORDER_SERVICE | CUSTOMER_CARE
  resourceType   String?      // LEAD | SERVICE_ORDER | CANDIDATE | CUSTOMER
  resourceId     String?
  title          String
  content        String?
  status         String       @default("PENDING") // PENDING | PROCESSING | COMPLETED | CANCELLED
  priority       String       @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([assigneeId, status])
}

model AsyncJob {
  id          String    @id @default(cuid())
  queueName   String    @default("DEFAULT") // NOTIFICATION | WECHAT_MSG | WEBHOOK | AI_TASK | REPORT
  handler     String    // 对应处理函数标识
  payloadJson String    @default("{}")
  status      String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  retryCount  Int       @default(0)
  maxRetries  Int       @default(3)
  errorMsg    String?
  runAt       DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([queueName, status, runAt])
}

model UnifiedQrCode {
  id               String        @id @default(cuid())
  codeKey          String        @unique // 唯一编码标识
  title            String        // 名称：如 "经开区招聘易拉宝"、"旗舰店立牌"
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  resourceType     String        // MERCHANT | ENTERPRISE | JOB | HOUSE | SERVICE | EVENT | SHOP
  resourceId       String?
  source           String        @default("POSTER") // POSTER | FLYER | WECHAT | STICKER | TABLE_CARD
  campaign         String?       // 运营活动标识
  scanCount        Int           @default(0)
  lastScannedAt    DateTime?
  targetUrl        String        // H5 跳转链接
  miniProgramPath  String        // 小程序直达路径 (如 /pages/jobs/detail?id=xxx)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([resourceType, resourceId])
  @@index([organizationId])
  @@index([codeKey])
}

model ApiKeyConfig {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  keyPrefix      String       // yl_live_xxx
  keyHash        String       // SHA-256 哈希
  scopes         String[]     @default(["jobs:read", "orders:read"])
  enabled        Boolean      @default(true)
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([keyPrefix])
}

model WebhookEndpoint {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String
  secret         String       // Webhook HMAC 签名密钥
  events         String[]     @default(["order.completed", "lead.created", "candidate.applied"])
  enabled        Boolean      @default(true)
  failureCount   Int          @default(0)
  lastDeliveredAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  deliveries     WebhookDelivery[]

  @@index([organizationId])
}

model WebhookDelivery {
  id          String          @id @default(cuid())
  endpointId  String
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event       String
  payloadJson String
  status      String          // SUCCESS | FAILED
  statusCode  Int?
  response    String?
  durationMs  Int             @default(0)
  createdAt   DateTime        @default(now())

  @@index([endpointId, createdAt])
}

// ==========================================
// P8: 业务事件总线 (Business Event Bus - Append-Only)
// ==========================================
model BusinessEvent {
  id             String    @id @default(cuid())
  eventType      String    // USER_REGISTERED, JOB_PUBLISHED, SERVICE_ORDER_CREATED, PAYMENT_SUCCEEDED, LEAD_CREATED, etc.
  userId         String?
  organizationId String?
  resourceType   String?   // JOB | HOUSE | INDUSTRIAL | INFO | COMMUNITY | SERVICE_PRODUCT | SERVICE_PROVIDER | MERCHANT
  resourceId     String?
  payloadJson    String    @default("{}")
  source         String    @default("SYSTEM") // WEB | MINI_PROGRAM | WORKSPACE | OPEN_API | SYSTEM | AGENT
  status         String    @default("PENDING") // PENDING | PROCESSED | FAILED | DEAD_LETTER
  retryCount     Int       @default(0)
  error          String?
  occurredAt     DateTime  @default(now())
  processedAt    DateTime?

  @@index([eventType])
  @@index([organizationId])
  @@index([status])
  @@index([occurredAt])
}

// ==========================================
// P8: AI Agent 执行记录与安全审计 (AgentActionLog)
// ==========================================
model AgentActionLog {
  id                  String    @id @default(cuid())
  agentId             String    // MERCHANT_AGENT | ENTERPRISE_AGENT | OPERATIONS_AGENT | RISK_AGENT
  userId              String
  organizationId      String?
  tool                String    // create_task, create_followup, etc.
  inputJson           String    @default("{}")
  resultJson          String    @default("{}")
  riskLevel           String    @default("LOW_RISK") // LOW_RISK | MEDIUM_RISK | HIGH_RISK
  approvalStatus      String    @default("AUTO_APPROVED") // AUTO_APPROVED | PENDING | APPROVED | REJECTED
  approvalRequestId   String?
  rollbackStatus      String    @default("NONE") // NONE | CAN_ROLLBACK | ROLLED_BACK | FAILED
  rollbackPayloadJson String?
  executedAt          DateTime  @default(now())

  @@index([agentId])
  @@index([organizationId])
  @@index([userId])
  @@index([executedAt])
}

// ==========================================
// P8: 敏感动作与中风险单级人工审批 (ApprovalRequest)
// ==========================================
model ApprovalRequest {
  id             String    @id @default(cuid())
  organizationId String?
  requesterId    String
  approverId     String?
  actionType     String    // BULK_MARKETING | EXPORT_DATA | BATCH_STATUS_UPDATE | AGENT_MEDIUM_ACTION
  title          String
  description    String?
  payloadJson    String    @default("{}")
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED
  riskLevel      String    @default("MEDIUM_RISK")
  reviewedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([status])
  @@index([requesterId])
}

// ==========================================
// P8: 统一自动化工作流引擎 (WorkflowRule & WorkflowExecution)
// ==========================================
model WorkflowRule {
  id                String              @id @default(cuid())
  organizationId    String?             // 属于具体租户或平台全局
  name              String
  description       String?
  triggerType       String              @default("EVENT") // EVENT | SCHEDULE | MANUAL | CONDITION
  triggerEvent      String?             // e.g. "order.completed", "lead.created"
  cronExpr          String?
  conditionJson     String              @default("{}")
  actionType        String              // SEND_NOTIFICATION | CREATE_TASK | ADD_TAG | CREATE_DRAFT | ASSIGN_OPERATOR | GENERATE_REPORT | ISSUE_COUPON | UPDATE_LOW_RISK_STATUS
  actionPayloadJson String              @default("{}")
  enabled           Boolean             @default(true)
  depthLimit        Int                 @default(3)
  executionCount    Int                 @default(0)
  successCount      Int                 @default(0)
  failureCount      Int                 @default(0)
  lastExecutedAt    DateTime?
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  executions        WorkflowExecution[]

  @@index([organizationId])
  @@index([triggerType])
  @@index([enabled])
}

model WorkflowExecution {
  id             String       @id @default(cuid())
  ruleId         String
  rule           WorkflowRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  triggerEventId String?
  organizationId String?
  status         String       @default("SUCCESS") // SUCCESS | FAILED | SKIPPED
  depth          Int          @default(1)
  inputJson      String       @default("{}")
  outputJson     String       @default("{}")
  error          String?
  durationMs     Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([ruleId, createdAt])
  @@index([organizationId])
}

// ==========================================
// P8: 平台数据中台统一指标注册表 (MetricRegistry & MetricValue)
// ==========================================
model MetricDefinition {
  id          String   @id @default(cuid())
  code        String   @unique // DAU, MAU, NEW_USERS, ORDERS, GMV, REFUND_RATE, LEAD_CONVERSION, REPEAT_RATE
  name        String
  category    String   @default("CORE") // CORE | REVENUE | TRAFFIC | SERVICE
  unit        String   @default("COUNT") // COUNT | CENTS | PERCENT | MS
  formula     String
  sourceTable String
  updatedAt   DateTime @updatedAt
}

model MetricValue {
  id             String   @id @default(cuid())
  metricCode     String
  region         String   @default("ALL") // ALL | YANG_LIN_ZHEN | UNIVERSITY_TOWN | JING_KAI_QU | SONG_MING
  industry       String   @default("ALL") // ALL | MANUFACTURING | FOOD | LOGISTICS | SERVICES | RETAIL
  dateStr        String   // YYYY-MM-DD
  valueNum       Float    @default(0)
  dimensionsJson String   @default("{}")
  createdAt      DateTime @default(now())

  @@unique([metricCode, region, industry, dateStr])
  @@index([metricCode, dateStr])
}

// ==========================================
// P8: 知识库 (KnowledgeBase - 平台规则与企业私有知识)
// ==========================================
model KnowledgeArticle {
  id             String   @id @default(cuid())
  organizationId String?  // null = 平台公共知识, 存在值 = 企业租户私有知识库
  title          String
  category       String   @default("GENERAL") // RULE | GUIDE | POLICY | FAQ | PRIVATE
  content        String
  source         String?  // 出处链接或文档来源
  owner          String?  // 归属部门或负责人
  status         String   @default("VERIFIED") // VERIFIED | DRAFT | REJECTED
  viewCount      Int      @default(0)
  helpfulCount   Int      @default(0)
  unhelpfulCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([category])
  @@index([status])
}


// ==========================================
// P8: AI Agent 人工评估反馈 (AgentEvaluation)
// ==========================================
model AgentEvaluation {
  id          String   @id @default(cuid())
  actionLogId String
  userId      String
  rating      String   // UP | DOWN
  feedback    String?
  createdAt   DateTime @default(now())

  @@index([actionLogId])
  @@index([userId])
}



// ==========================================
// 自营便利店 (杨林生活网自营零售 P0)
// ==========================================

model MallCategory {
  id             String    @id @default(cuid())
  name           String    @unique
  icon           String?
  sortOrder      Int       @default(0)
  restrictedSale Boolean   @default(false)
  status         String    @default("ACTIVE") // ACTIVE | DISABLED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]

  @@index([status, sortOrder])
}

model Product {
  id                 String          @id @default(cuid())
  name               String
  subtitle           String?
  categoryId         String
  category           MallCategory    @relation(fields: [categoryId], references: [id])
  brand              String?
  barcode            String?
  coverImage         String?
  images             String[]        @default([])
  unit               String          @default("件")
  priceCents         Int
  originalPriceCents Int?
  costCents          Int?
  stock              Int             @default(0)
  lowStockThreshold  Int             @default(5)
  salesCount         Int             @default(0)
  status             String          @default("ON_SALE") // DRAFT | ON_SALE | OFF_SALE | SOLD_OUT
  isFeatured         Boolean         @default(false)
  isHot              Boolean         @default(false)
  isNew              Boolean         @default(false)
  isSelfOperated     Boolean         @default(true)
  description        String?
  specification      String?
  restrictedSale     Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  orderItems         MallOrderItem[]

  @@index([categoryId, status])
  @@index([status, isFeatured, isHot, isNew])
}

model DeliveryZone {
  id                         String    @id @default(cuid())
  name                       String    @unique
  feeCents                   Int       @default(300)
  freeShippingThresholdCents Int       @default(2900)
  estimatedMinutes           String?   @default("30-45分钟")
  enabled                    Boolean   @default(true)
  sortOrder                  Int       @default(0)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}

model Courier {
  id             String      @id @default(cuid())
  userId         String?
  name           String
  phone          String      @unique
  accessCode     String      @default("888888")
  status         String      @default("ACTIVE") // ACTIVE | INACTIVE
  remark         String?
  totalDelivered Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orders         MallOrder[]
}

model MallOrder {
  id                   String          @id @default(cuid())
  orderNo              String          @unique
  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryMethod       String          // DELIVERY | PICKUP
  status               String          @default("WAITING_PAYMENT")
  
  // 自提专属
  pickupCode           String?
  pickedUpAt           DateTime?
  
  // 配送执行信息
  deliveryType         String?         // OWNER | COURIER | THIRD_PARTY
  assignedCourierId    String?
  courier              Courier?        @relation(fields: [assignedCourierId], references: [id], onDelete: SetNull)
  thirdPartyPlatform   String?
  thirdPartyRiderName  String?
  thirdPartyRiderPhone String?
  thirdPartyFeeCents   Int?
  thirdPartyNotes      String?
  
  // 收件人/自提人信息
  contactName          String
  contactPhone         String
  deliveryZoneId       String?
  deliveryZoneName     String?
  addressDetail        String?
  expectedDeliveryTime String?
  userRemark           String?
  
  // 财务金额 (分)
  goodsTotalCents      Int
  deliveryFeeCents     Int             @default(0)
  discountCents        Int             @default(0)
  payAmountCents       Int
  paymentMethod        String          @default("WECHAT")
  paidAt               DateTime?
  transactionId        String?
  
  // 节点时间戳
  pickingAt            DateTime?
  readyAt              DateTime?
  deliveringAt         DateTime?
  deliveredAt          DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  
  items                MallOrderItem[]
  logs                 MallOrderLog[]
  afterSale            MallAfterSale?

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([assignedCourierId, status])
  @@index([pickupCode])
}

model MallOrderItem {
  id            String    @id @default(cuid())
  orderId       String
  order         MallOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName   String
  productCover  String?
  specification String?
  unit          String    @default("件")
  priceCents    Int
  quantity      Int
  totalCents    Int
  createdAt     DateTime  @default(now())

  @@index([orderId])
}

model MallOrderLog {
  id           String    @id @default(cuid())
  orderId      String
  order        MallOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  operator     String    // USER | ADMIN | COURIER | SYSTEM
  operatorName String?
  action       String
  notes        String?
  metadata     Json?
  createdAt    DateTime  @default(now())

  @@index([orderId, createdAt])
}

model MallAfterSale {
  id                String    @id @default(cuid())
  afterSaleNo       String    @unique
  orderId           String    @unique
  order             MallOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId            String
  reason            String
  description       String
  images            String[]  @default([])
  refundAmountCents Int
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED | REFUNDED | CLOSED
  adminNotes        String?
  revertStock       Boolean   @default(false)
  wechatRefundId    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([orderId, status])
}
