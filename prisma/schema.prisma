// ==========================================
// 微信公众号运营系统 — P0 基础模型
// ==========================================

// 渠道二维码
model WechatQrCode {
  id             String    @id @default(cuid())
  name           String // 二维码名称：如"招聘海报"
  scene          String    @unique // 场景值（唯一标识）
  type           String    @default("TEMP") // TEMP=临时 | PERM=永久
  expireAt       DateTime? // 临时二维码过期时间
  wechatTicket   String? // 微信返回的 ticket
  qrUrl          String? // 二维码图片URL
  targetType     String    @default("WELCOME") // WELCOME=差异化欢迎 | URL=跳转 | TAG=自动标签
  targetValue    String? // 对应目标值（如自定义欢迎语、跳转URL）
  welcomeMsg     String? // 差异化欢迎语（覆盖默认）
  autoTagIds     String[]  @default([]) // 自动打标签ID列表
  enabled        Boolean   @default(true)
  scanCount      Int       @default(0) // 扫描次数
  subscribeCount Int       @default(0) // 通过此码关注人数
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([enabled])
  @@index([scene])
}

// 用户标签
model WechatUserTag {
  id          String              @id @default(cuid())
  name        String              @unique // 标签名：如"招聘用户"、"杨林大学城"
  category    String              @default("SYSTEM") // SYSTEM=系统标签 | INTEREST=兴趣标签 | IDENTITY=身份标签 | REGION=区域标签 | CUSTOM=运营标签
  color       String              @default("#3b82f6") // 标签颜色
  description String?
  wechatTagId Int? // 微信端标签ID（如果已同步到微信）
  autoRule    Json? // 自动标签规则 {eventType, threshold, windowDays}
  enabled     Boolean             @default(true)
  usageCount  Int                 @default(0)
  createdBy   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  relations   WechatTagRelation[]

  @@index([category])
}

// 用户-标签关联
model WechatTagRelation {
  id         String         @id @default(cuid())
  followerId String
  follower   WechatFollower @relation(fields: [followerId], references: [id], onDelete: Cascade)
  tagId      String
  tag        WechatUserTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  source     String         @default("MANUAL") // MANUAL=人工 | AUTO=自动规则 | QR=二维码 | SYSTEM=系统
  createdAt  DateTime       @default(now())

  @@unique([followerId, tagId])
  @@index([tagId])
}

// 用户行为记录
model WechatUserEvent {
  id         String          @id @default(cuid())
  openId     String
  followerId String?
  follower   WechatFollower? @relation(fields: [followerId], references: [id], onDelete: SetNull)
  userId     String?
  eventType  String // FOLLOW | UNFOLLOW | SCAN_QR | KEYWORD | MENU_CLICK | WEB_LOGIN | ACCOUNT_BIND | AD_INQUIRY | CUSTOMER_SERVICE
  eventName  String? // 具体事件名：如关键词内容、菜单名、二维码场景
  eventValue String? // 附加值：如匹配的关键词组名、菜单URL
  source     String? // 来源：如二维码场景值
  createdAt  DateTime        @default(now())

  @@index([openId])
  @@index([eventType])
  @@index([createdAt])
  @@index([followerId])
}

// 客服咨询会话
model WechatCustomerConversation {
  id            String          @id @default(cuid())
  openId        String
  followerId    String?
  follower      WechatFollower? @relation(fields: [followerId], references: [id], onDelete: SetNull)
  userId        String?
  category      String          @default("GENERAL") // GENERAL=一般咨询 | ADVERTISING=广告合作 | MERCHANT=商家入驻 | RECRUITMENT=企业招聘 | COMPLAINT=投诉 | OTHER=其他
  status        String          @default("WAITING") // WAITING=待处理 | PROCESSING=处理中 | CLOSED=已关闭
  lastMessage   String? // 最近一条消息
  lastMessageAt DateTime?
  assignedTo    String? // 分配给谁处理
  note          String? // 处理备注
  closedAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
  @@index([openId])
  @@index([createdAt])
}

// 商业线索
model BusinessLead {
  id         String          @id @default(cuid())
  openId     String
  followerId String?
  follower   WechatFollower? @relation(fields: [followerId], references: [id], onDelete: SetNull)
  userId     String?
  type       String          @default("OTHER") // ADVERTISING=广告 | MERCHANT=商家入驻 | RECRUITMENT=企业招聘 | OTHER=其他
  source     String          @default("WECHAT") // WECHAT=公众号 | WEB=网站 | QR=二维码
  content    String? // 用户消息内容
  status     String          @default("NEW") // NEW=新线索 | FOLLOWING=跟进中 | CONTACTED=已联系 | QUOTED=已报价 | CLOSED=已成交 | INVALID=无效
  assignedTo String?
  note       String? // 跟进备注
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([type])
  @@index([status])
  @@index([openId])
  @@index([createdAt])
}

// 消息通知模板
model WechatNotificationTemplate {
  id          String   @id @default(cuid())
  scene       String   @unique // 场景标识：CONTENT_APPROVED | CONTENT_REJECTED | JOB_PUBLISHED | HOUSE_PUBLISHED | AD_START | AD_EXPIRING
  name        String // 场景名称
  templateId  String? // 微信模板消息ID
  enabled     Boolean  @default(false)
  titleField  String? // 标题字段映射
  contentMap  Json? // 内容字段映射 {first, keyword1, keyword2, remark}
  jumpUrl     String? // 点击跳转URL模板
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
