generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  REVIEWER
  USER
}

enum ContentStatus {
  DRAFT
  PENDING
  APPROVED
  OFFLINE
  REJECTED
  EXPIRED
  RESOLVED
  SOLD
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

model User {
  id                 String            @id @default(cuid())
  username           String            @unique
  nickname           String?
  avatar             String?
  passwordHash       String
  role               Role              @default(USER)
  status             String            @default("ACTIVE") // ACTIVE | DISABLED
  sessionVersion     Int               @default(1)
  phone              String?           @unique
  phoneVerifiedAt    DateTime?
  wechatOpenId       String?           @unique
  wechatUnionId      String?           @unique
  wechatNickname     String?
  wechatAvatar       String?
  passwordChangedAt  DateTime?
  // Profile provenance prevents an external identity provider from overwriting
  // a member's own profile image or nickname.
  avatarSource       String?
  nicknameSource     String?
  registrationSource String?
  lastLoginAt        DateTime?
  lastActiveAt       DateTime?
  lastLoginProvider  String?
  createdAt          DateTime          @default(now())
  logs               OperationLog[]
  billingOrders      BillingOrder[] @relation("UserOrders")
  articles           Article[]
  jobs               Job[]
  listings           Listing[]
  houses             House[]
  shops              Shop[]
  posts              Post[]
  comments           PostComment[]
  postLikes          PostLike[]
  bannedUntil        DateTime?         // 社区禁言截止时间
  communityBadge     String?           // 社区身份勋章: 学生认证 | 经开区职工 | 街坊认证 | 版主
  events             Event[]
  signups            EventSignup[]
  datingProfiles     DatingProfile[]
  favorites          Favorite[]
  notifications      Notification[]
  reports            Report[]
  searchLogs         SearchLog[]
  pointAccount       PointAccount?
  memberships        UserMembership[]
  coinWallet         CoinWallet?
  contactPurchases   ContactPurchase[]
  resumes            Resume[]
  jobApplications    JobApplication[]
  authAccounts       AuthAccount[]
  wechatAccounts     WechatAccount[]
  loginLogs          LoginLog[]
  wechatFollower     WechatFollower?
  industrialProperties IndustrialProperty[]
  listingPromotions  ListingPromotion[]
  serviceProvider    ServiceProvider?
  serviceRequests    ServiceRequest[]
  reviews            Review[]
  contactEvents      ContactEvent[]
  addresses          UserAddress[]
  customerServiceOrders ServiceOrder[] @relation("CustomerServiceOrders")
  refunds            Refund[]
  afterSales         AfterSale[]
  follows            FollowProvider[]
  userCoupons        UserCoupon[]
  userPreference     UserPreference?
  verificationRecords VerificationRecord[]
  analyticsEvents     AnalyticsEvent[]
  aiUsageLogs         AiUsageLog[]
  aiConversations     AiConversation[]
  // P7: 多端统一与组织架构扩展
  wechatIdentities   WechatIdentity[]
  organizationMembers OrganizationMember[]
  assignedTasks      OrganizationTask[]
  mallOrders         MallOrder[]
  assignedTechnicianOrders ServiceOrder[] @relation("TechnicianOrders")
  ownedOrganizations Organization[]  @relation("OrganizationOwner")
  candidates         Candidate[]

}

model WechatFollower {
  id                String                       @id @default(cuid())
  openId            String                       @unique
  unionId           String?
  nickname          String?
  avatar            String?
  subscribed        Boolean                      @default(false)
  subscribeTime     DateTime?
  unsubscribedAt    DateTime?
  firstSeenSource   String                       @default("OAUTH")
  qrScene           String? // 关注时的二维码场景值
  lastSyncedAt      DateTime                     @default(now())
  lastInteractionAt DateTime? // 最近互动时间
  userId            String?                      @unique
  user              User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  tags              WechatTagRelation[]
  events            WechatUserEvent[]
  conversations     WechatCustomerConversation[]
  leads             BusinessLead[]

  @@index([unionId])
  @@index([subscribed])
  @@index([qrScene])
}

model DatingProfile {
  id            String        @id @default(cuid())
  gender        String        @default("female") // female | male
  nickname      String
  birthYear     Int           @default(1995)
  heightCm      Int           @default(165)
  education     String        @default("本科")
  occupation    String
  income        String        @default("5000-8000元/月")
  maritalStatus String        @default("未婚")
  location      String        @default("杨林本地")
  requirement   String
  intro         String
  photos        String[]      @default([])
  contact       String
  status        ContentStatus @default(DRAFT)
  viewsCount    Int           @default(0)
  authorId      String?
  author        User?         @relation(fields: [authorId], references: [id])
  oldId         String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Event {
  id        String        @id @default(cuid())
  title     String
  category  String        @default("outdoor")
  eventTime String
  location  String
  fee       String        @default("免费")
  quota     String        @default("不限")
  contact   String
  intro     String
  images    String[]      @default([])
  status    ContentStatus @default(DRAFT)
  isTop     Boolean       @default(false)
  topUntil  DateTime?
  authorId  String?
  author    User?         @relation(fields: [authorId], references: [id])
  oldId     String?       @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  signups   EventSignup[]
}

model EventSignup {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  phone     String
  numPeople Int      @default(1)
  note      String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Post {
  id             String        @id @default(cuid())
  title          String
  board          String        @default("yanglin") // yanglin | news | help | life | college | trade
  category       String        @default("share")   // share | help | trade | news | topic | yanglin | college
  body           String
  images         String[]      @default([])
  topics         String[]      @default([])        // 关联话题标签，如 ["大学城美食", "经开区生活"]
  status         ContentStatus @default(DRAFT)
  isTop          Boolean       @default(false)
  topUntil       DateTime?
  isFeatured     Boolean       @default(false)     // 社区精选推荐
  resolvedStatus String        @default("OPEN")    // 求助帖状态: OPEN | RESOLVED
  viewsCount     Int           @default(0)
  repliesCount   Int           @default(0)
  likesCount     Int           @default(0)         // 真实点赞数
  favoritesCount Int           @default(0)         // 真实收藏数
  authorId       String?
  author         User?         @relation(fields: [authorId], references: [id])
  oldId          String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  comments       PostComment[]
  likes          PostLike[]

  @@index([board, status])
  @@index([category, status])
  @@index([createdAt])
}

model PostComment {
  id         String        @id @default(cuid())
  postId     String
  post       Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId   String?       // 二级回复树形嵌套 (父级评论ID)
  parent     PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    PostComment[] @relation("CommentReplies")
  content    String
  likesCount Int           @default(0)
  isFeatured Boolean       @default(false)
  authorId   String?
  author     User?         @relation(fields: [authorId], references: [id])
  createdAt  DateTime      @default(now())

  @@index([postId])
  @@index([parentId])
}

model PostLike {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Topic {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  icon        String   @default("💬")
  description String?
  postsCount  Int      @default(0)
  viewsCount  Int      @default(0)
  isHot       Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isHot])
}

model Article {
  id        String        @id @default(cuid())
  title     String
  body      String
  category  String        @default("life")
  status    ContentStatus @default(DRAFT)
  authorId  String?
  author    User?         @relation(fields: [authorId], references: [id])
  images    String[]      @default([])
  oldId     String?       @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Job {
  id                  String           @id @default(cuid())
  title               String
  company             String
  companyNameSnapshot String?
  companyLogoSnapshot String?
  companyId           String?
  companyEntity       Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactName         String?
  contactPhone        String?
  contactWechat       String?
  address             String?
  body                String
  jobType             String           @default("fulltime") // fulltime | parttime
  area                String           @default("杨林地区")
  salary              String           @default("面议")
  status              ContentStatus    @default(DRAFT)
  isTop               Boolean          @default(false)
  topUntil            DateTime?
  authorId            String?
  author              User?            @relation(fields: [authorId], references: [id])
  images              String[]         @default([])
  oldId               String?          @unique
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  applications        JobApplication[]
  organizationId      String?
  organization        Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  candidates          Candidate[]

  @@index([companyId])
  @@index([organizationId])
}

// ==========================================
// 人才简历库 (复刻老站 mh163k_Job_Resume)
// ==========================================

model Resume {
  id           String           @id @default(cuid())
  name         String // 求职者姓名
  gender       String           @default("male") // male=男 | female=女
  birthYear    Int              @default(1998) // 出生年份
  education    String           @default("大专") // 初中及以下 | 高中/中专 | 大专 | 本科 | 硕士及以上
  experience   String           @default("1-3年") // 应届生 | 1年以内 | 1-3年 | 3-5年 | 5-10年 | 10年以上
  targetJob    String // 期望职位: 如「行政文员」「销售主管」「厨师」「司机」
  targetSalary String           @default("3000-5000元/月")
  targetArea   String           @default("杨林职教园区")
  jobStatus    String           @default("LOOKING") // LOOKING=离职-随时到岗 | OPEN=在职-月内到岗 | NOT_LOOKING=暂不找工作
  skills       String? // 技能/证书标签
  intro        String // 自我评价与工作履历
  phone        String // 联系手机
  wechat       String? // 微信号
  avatar       String? // 个人免冠/生活照
  status       ContentStatus    @default(APPROVED) // DRAFT | PENDING | APPROVED | OFFLINE
  isTop        Boolean          @default(false)
  topUntil     DateTime?
  viewsCount   Int              @default(0)
  authorId     String?
  author       User?            @relation(fields: [authorId], references: [id])
  oldId        String?          @unique
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]
  candidates   Candidate[]

  @@index([targetJob])
  @@index([status])
  @@index([isTop])
}

// ==========================================
// 职位投递与应聘意向 (复刻老站 mh163k_Job_PostApplication)
// ==========================================

model JobApplication {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING") // PENDING=待查看 | VIEWED=已查阅 | INVITED=邀面试 | REJECTED=不合适
  note      String? // 企业回评备注
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId, status])
  @@index([resumeId])
  @@index([userId])
}

model Listing {
  id            String        @id @default(cuid())
  title         String
  category      String
  subCategory   String?       // 二级细分子类
  itemType      String        @default("OFFER") // OFFER | WANTED | TRANSFER | FOR_SALE | FOR_RENT | WANTED_BUY | WANTED_RENT | HELP
  price         String?       @default("面议")
  priceNum      Float?        // 数字价格便于排序与过滤
  priceUnit     String?       @default("元")
  condition     String?       // 物品成色: 全新 | 95新 | 9成新 | 8成新 | 不限
  area          String        @default("杨林经开区")
  address       String?       // 详细地址或发车/交易地点
  contact       String
  contactName   String?       // 联系人称呼
  wechat        String?       // 微信号
  body          String
  images        String[]      @default([])
  viewsCount    Int           @default(0)
  likesCount    Int           @default(0)
  status            ContentStatus      @default(DRAFT)
  rejectReason      String?            // 审核驳回原因
  expiresAt         DateTime?          // 信息到期时间
  isTop             Boolean            @default(false)
  topUntil          DateTime?          // 分类置顶截止时间
  isFeatured        Boolean            @default(false) // 分类精选推荐
  featuredUntil     DateTime?          // 分类精选推荐截止时间
  isHomeFeatured    Boolean            @default(false) // 首页大厅精选推荐
  homeFeaturedUntil DateTime?          // 首页精选推荐截止时间
  promotions        ListingPromotion[] // 推广订单流水与权益关联
  contactEvents     ContactEvent[]     // 联系行为统计
  refreshedAt       DateTime           @default(now())
  departureTime     String?            // 顺风车发车时间
  fromPlace         String?            // 顺风车出发地
  toPlace           String?            // 顺风车目的地
  extraData         Json?              // 分类扩展动态字段 (如车型、空位、科目、年级、宠物年龄等)
  authorId          String?
  author            User?              @relation(fields: [authorId], references: [id])
  oldId             String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([category, status])
  @@index([subCategory])
  @@index([area])
  @@index([refreshedAt])
  @@index([isTop])
  @@index([status, expiresAt])
  @@index([isFeatured, refreshedAt])
  @@index([isHomeFeatured, refreshedAt])
}

model House {
  id        String        @id @default(cuid())
  title     String
  houseType String        @default("rent") // rent | secondhand | newhouse | shop
  price     String        @default("面议")
  layout    String        @default("不限")
  areaSize  String        @default("不限")
  location  String        @default("杨林地区")
  contact   String
  body      String
  status    ContentStatus @default(DRAFT)
  isTop     Boolean       @default(false)
  topUntil  DateTime?
  authorId  String?
  author    User?         @relation(fields: [authorId], references: [id])
  images    String[]      @default([])
  oldId     String?       @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Shop {
  id         String        @id @default(cuid())
  name       String
  category   String        @default("food") // food | service | entertainment | digital
  address    String        @default("杨林地区")
  phone      String
  hours      String        @default("09:00 - 21:00")
  intro      String
  logo       String?
  images     String[]      @default([])
  status     ContentStatus @default(DRAFT)
  isFeatured Boolean       @default(false)
  isTop      Boolean       @default(false)
  topUntil   DateTime?
  authorId   String?
  author     User?         @relation(fields: [authorId], references: [id])
  oldId      String?       @unique
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Favorite {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceType String // JOB | HOUSE | LISTING | SHOP | EVENT | DATING | POST
  resourceId   String
  title        String
  link         String
  createdAt    DateTime @default(now())

  @@unique([userId, resourceType, resourceId])
  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String    @default("ALL") // ALL | ORDER | INTERACTION | SYSTEM | PROMOTION
  type      String // COMMENT_REPLY | POST_REPLY | FAVORITE | EVENT_SIGNUP | CONTENT_APPROVED | CONTENT_REJECTED | SYSTEM_NOTICE | ACCOUNT_SECURITY
  title     String
  content   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, category])
}

model Report {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceType String // JOB | HOUSE | LISTING | SHOP | EVENT | DATING | POST
  resourceId   String
  title        String
  reason       String
  status       String   @default("PENDING") // PENDING | PROCESSING | RESOLVED | REJECTED
  createdAt    DateTime @default(now())

  @@index([userId])
}

model SearchLog {
  id                String   @id @default(cuid())
  keyword           String
  normalizedKeyword String
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  resultCount       Int      @default(0)
  resourceType      String?
  durationMs        Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([keyword])
  @@index([createdAt])
}

model BillingPlan {
  id           String         @id @default(cuid())
  name         String
  targetKind   String
  priceCents   Int
  durationDays Int
  enabled      Boolean        @default(true)
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  orders       BillingOrder[]
}

model BillingSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model BillingOrder {
  id             String       @id @default(cuid())
  orderNo        String       @unique
  planId         String?
  planName       String
  targetKind     String
  targetId       String
  targetTitle    String
  amountCents    Int
  assetType      String       @default("RMB") // RMB | COIN | POINT | FREE_QUOTA
  amountRmbCents Int          @default(0)
  coinAmount     Int          @default(0)
  pointAmount    Int          @default(0)
  quoteId        String?
  entitlementId  String?
  paymentChannel String?      // WECHAT_PAY | COIN_BALANCE | POINT_BALANCE | FREE_QUOTA
  status         OrderStatus  @default(PENDING_PAYMENT)
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  plan           BillingPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  userId         String?
  organizationId String?
  user           User?        @relation("UserOrders", fields: [userId], references: [id], onDelete: SetNull)

  @@index([targetKind, targetId])
  @@index([status])
  @@index([userId])
  @@index([organizationId])
  @@index([quoteId])
}

// ==========================================
// 免费额度使用记录 (防刷、按主体按周期计次)
// ==========================================

model BillingQuotaUsage {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  companyId      String?
  module         String   // job | house | listing | love | ...
  action         String   @default("PUBLISH") // PUBLISH | TOP | REFRESH
  periodKey      String   // e.g. "ONCE", "2026-09", "2026-09-18"
  usedCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, module, action, periodKey])
  @@index([companyId, module, action, periodKey])
  @@index([organizationId, module, action, periodKey])
}

// ==========================================
// 服务端防篡改即时报价快照 (BillingQuote)
// ==========================================

model BillingQuote {
  id             String   @id @default(cuid())
  userId         String
  organizationId String?
  companyId      String?
  module         String   // job | house | listing | ...
  action         String   @default("PUBLISH") // PUBLISH | TOP | HIGHLIGHT | REFRESH
  isFree         Boolean  @default(false)
  freeReason     String?  // FREE_QUOTA | GLOBAL_FREE_CAMPAIGN | ADMIN_GRANT
  allowRmb       Boolean  @default(true)
  priceRmbCents  Int      @default(0)
  allowCoin      Boolean  @default(false)
  priceCoins     Int      @default(0)
  allowPoint     Boolean  @default(false)
  pricePoints    Int      @default(0)
  days           Int?     // 用于置顶等按天增值服务
  metadata       Json?    // 暂存草稿数据与目标快照
  status         String   @default("ACTIVE") // ACTIVE | CONSUMED | EXPIRED
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([userId, status])
  @@index([companyId, status])
}

// ==========================================
// 支付与发帖解耦权益凭证 (BillingEntitlement)
// ==========================================

model BillingEntitlement {
  id             String    @id @default(cuid())
  userId         String
  organizationId String?
  companyId      String?
  module         String    // job | house | listing | ...
  action         String    @default("PUBLISH")
  assetType      String    // RMB | COIN | POINT | FREE_QUOTA | ADMIN_GRANT
  sourceOrderId  String?
  quoteId        String?
  status         String    @default("AVAILABLE") // AVAILABLE | CONSUMED | EXPIRED | REVOKED
  resourceId     String?   // 绑定生成的内容 ID (Job/House 等)
  metadata       Json?
  usedAt         DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@index([userId, module, status])
  @@index([companyId, module, status])
  @@index([quoteId])
}

model OperationLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([targetId])
  @@index([createdAt])
}

// ==========================================
// 收费策略管理 (复刻老站 YL_Charge_Config)
// ==========================================

model ChargeConfig {
  id                  String   @id @default(cuid())
  moduleKey           String   @unique // job | house | shop | listing | event | love | post | article
  moduleName          String // 招聘信息 | 房产楼市 | 好店商家 | ...
  unitPrice           Int      @default(0) // 基础发帖单价(分)
  discountRate        Float    @default(1.0) // 折扣率 0~1
  isFree              Boolean  @default(true) // 该板块是否免费发布
  isEnabled           Boolean  @default(true) // 是否启用该板块
  freePostCount       Int      @default(3) // 首刷免费额度(条)
  expiryDays          Int      @default(30) // 信息有效期(天), 0=永不过期
  pinnedPriceDaily    Int      @default(500) // 置顶日单价(分) 默认5元/天
  highlightPriceDaily Int      @default(300) // 加红日单价(分) 默认3元/天
  refreshPriceOnce    Int      @default(100) // 刷新单次费用(分) 默认1元/次
  maleAuditPrice      Int      @default(0) // 相亲男生审核费(分)
  femaleAuditPrice    Int      @default(0) // 相亲女生审核费(分)
  chargeType          String   @default("COUNT") // COUNT=按次 | MONTHLY=按月
  policyJson          String? // 扩展策略JSON
  sortOrder           Int      @default(0)

  // ── 三种支付介质与免费额度 ──
  allowRmb            Boolean  @default(true) // 允许人民币现金微信支付
  priceRmbCents       Int      @default(0)    // 人民币发帖单价(分)
  allowCoin           Boolean  @default(true) // 允许金币支付
  priceCoins          Int      @default(0)    // 金币发帖价格(枚)
  allowPoint          Boolean  @default(false)// 允许积分支付
  pricePoints         Int      @default(0)    // 积分发帖价格(分)
  freeQuota           Int      @default(1)    // 周期内免费额度(条)
  quotaPeriod         String   @default("30D")// 额度周期: ONCE | DAILY | 7D | 30D | 365D
  validDays           Int      @default(30)   // 信息展现有效期(天)

  // ── 增值服务多介质支持 ──
  pinnedAllowRmb      Boolean  @default(true)
  pinnedPriceRmbCents Int      @default(500)
  pinnedAllowCoin     Boolean  @default(true)
  pinnedPriceCoins    Int      @default(50)
  pinnedAllowPoint    Boolean  @default(false)
  pinnedPricePoints   Int      @default(500)

  highlightAllowRmb   Boolean  @default(true)
  highlightPriceRmbCents Int   @default(300)
  highlightAllowCoin  Boolean  @default(true)
  highlightPriceCoins Int      @default(30)

  refreshAllowRmb     Boolean  @default(true)
  refreshPriceRmbCents Int     @default(100)
  refreshAllowCoin    Boolean  @default(true)
  refreshPriceCoins   Int      @default(10)
  refreshAllowPoint   Boolean  @default(false)
  refreshPricePoints  Int      @default(100)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ==========================================
// B2B/B2C 会员等级包 (招聘企业包/相亲VIP/商家年费)
// ==========================================

model MemberVipPackage {
  id           String           @id @default(cuid())
  targetModule String // JOB=招聘企业包 | LOVE=相亲VIP | SHOP=商家入驻年费
  name         String // 套餐名称: 如「企业季度直聘包」「至尊红娘相亲VIP」「金牌商家入驻年卡」
  level        Int              @default(1) // 1=初级/体验, 2=中级/标准, 3=高级/旗舰
  priceCents   Int // 价格(分)
  durationDays Int // 有效时长(天) 如 30, 90, 365
  privileges   Json // 权益配额 JSON: { maxJobs: 20, maxResumes: 50, matchTimes: 5, giftPinnedDays: 7 }
  description  String?
