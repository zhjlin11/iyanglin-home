}

model UserMembership {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId      String
  package        MemberVipPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
