# ==============================================================================
# 杨林生活网 (iyanglin.com) - 环境变量配置模板
# 生产部署时请复制为 .env 或 .env.local 并填入真实凭据，严禁将包含真实密钥的文件提交至代码仓库！
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础服务与数据库
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3006
# PostgreSQL 连接串: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL="postgresql://vasto_admin:your_db_password@localhost:5432/yanglin_db?schema=public"

# 客户端会话令牌签名密钥 (HMAC-SHA256，推荐使用 openssl rand -hex 32 生成)
AUTH_SECRET="your_secure_auth_secret_minimum_32_characters"

# ------------------------------------------------------------------------------
# 2. 微信公众号 (WeChat Official Account)
# ------------------------------------------------------------------------------
WECHAT_MP_APP_ID="wx_your_wechat_mp_app_id"
WECHAT_MP_APP_SECRET="your_wechat_mp_app_secret"

# ------------------------------------------------------------------------------
# 3. 微信开放平台 (WeChat Open Platform - PC端网页扫码登录)
# ------------------------------------------------------------------------------
WECHAT_OPEN_APP_ID="wx_your_open_app_id"
WECHAT_OPEN_APP_SECRET="your_open_app_secret"

# ------------------------------------------------------------------------------
# 4. 腾讯云短信 (Tencent Cloud SMS)
# ------------------------------------------------------------------------------
TENCENT_SMS_APP_ID="your_sms_app_id"
TENCENT_SMS_APP_KEY="your_sms_app_key"
TENCENT_SMS_TEMPLATE_ID="your_sms_template_id"
TENCENT_SMS_SIGN="杨林生活网"

# ------------------------------------------------------------------------------
# 5. 微信支付商户中心 (WeChat Pay)
# ------------------------------------------------------------------------------
WECHAT_PAY_MCH_ID="your_mch_id"
WECHAT_PAY_API_KEY="your_mch_api_v2_v3_key"
WECHAT_PAY_NOTIFY_URL="https://iyanglin.com/api/payment/wechat/notify"
# 微信支付退款/敏感操作客户端证书路径 (推荐存放于项目外的私密证书目录，如 /etc/ssl/wechat/ 或 cert/)
WECHAT_PAY_CERT_PATH="./cert/apiclient_cert.pem"
WECHAT_PAY_KEY_PATH="./cert/apiclient_key.pem"

# ------------------------------------------------------------------------------
# 6. 管理员初始账号 (可选，用于本地开发环境快速初始化)
# ------------------------------------------------------------------------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your_initial_admin_password"

# ------------------------------------------------------------------------------
# 7. 构建与版本元数据 (通常由 CI/CD 自动注入)
# ------------------------------------------------------------------------------
APP_VERSION="1.0.0"
GIT_COMMIT="e5fa066de5ad20a7e85ea47fc36b39bd6e473130"
BUILD_TIME="2026-09-18T20:35:27+08:00"
