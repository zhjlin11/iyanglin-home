# ==============================================================================
# 杨林生活网 (iyanglin.com) - Nginx 生产反向代理与静态资源配置模板
# 目标安装路径: /etc/nginx/sites-available/iyanglin.com.conf
# 软链激活路径: /etc/nginx/sites-enabled/iyanglin.com.conf
# ==============================================================================

# 1. HTTP 80 强制重定向至 HTTPS
server {
    listen 80;
    server_name iyanglin.com www.iyanglin.com;
    return 301 https://iyanglin.com$request_uri;
}

# 2. HTTPS www 统一 301 重定向至主域名
server {
    listen 443 ssl http2;
    server_name www.iyanglin.com;

    # SSL 证书配置 (推荐通过 certbot --nginx 自动申请管理)
    ssl_certificate /etc/letsencrypt/live/iyanglin.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/iyanglin.com/privkey.pem;

    return 301 https://iyanglin.com$request_uri;
}

# 3. HTTPS 主站点服务
server {
    listen 443 ssl http2;
    server_name iyanglin.com;

    # SSL 安全增强配置
    ssl_certificate /etc/letsencrypt/live/iyanglin.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/iyanglin.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1440m;

    # 请求体限制与文件上传支持
    client_max_body_size 50M;

    # Gzip 高性能压缩
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss image/svg+xml;
    gzip_min_length 1024;

    # 安全响应头
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;

    # 静态上传资源直接由 Nginx 高速代理 (绕过 Node.js 提升性能)
    location ^~ /UploadFile/ {
        root /var/www/iyanglin.com/public;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location ^~ /uploadfile/ {
        root /var/www/iyanglin.com/public;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location ^~ /uploads/ {
        root /var/www/iyanglin.com/public;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    # Next.js 静态静态构建资源缓存优化
    location ^~ /_next/static/ {
        proxy_pass http://127.0.0.1:3006;
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # 主动态反向代理 (代理至 Next.js Standalone 端口 3006)
    location / {
        proxy_pass http://127.0.0.1:3006;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 120s;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
    }
}
