export async function generateMetadata({ params }: PageProps): Promise<Metadata> {
  const { id } = await params;
  const allListings = await listContent("listing");
  const item = allListings.find((entry) => entry.id === id);
  if (!item) return {};

  const catLabel = categoryLabels[item.category || ""] || "分类信息";
  const title = `${item.title} - ${catLabel} - 杨林生活网`;
  const description = `${item.title}。分类：${catLabel}。更多杨林本地二手交易、便民服务与求购闲置信息请上杨林生活网。`;

  return {
    title,
    description,
    keywords: [item.title, catLabel, "杨林二手", "杨林服务", "杨林生活网"],
    openGraph: {
      title,
      description,
      type: "article",
      url: `https://iyanglin.com/info/${item.id}`,
      siteName: "杨林生活网",
    },
    alternates: {
      canonical: `https://iyanglin.com/info/${item.id}`,
    },
  };
}

function formatPublishTime(dateString: string) {
  const date = new Date(dateString);
  const now = new Date();
  const diffMs = now.getTime() - date.getTime();
  const diffHours = diffMs / (1000 * 60 * 60);
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

  if (diffHours < 24 && date.getDate() === now.getDate()) {
    return "🔥 刚刚发布";
  } else if (diffDays === 1 || (diffHours < 48 && date.getDate() === now.getDate() - 1)) {
    return "⏱️ 昨天发布";
  } else if (diffDays > 1 && diffDays <= 7) {
    return `${diffDays}天前发布`;
  } else {
    return date.toLocaleDateString("zh-CN");
  }
}

function calcViewsAndFavs(idString: string) {
  let hash = 0;
  for (let i = 0; i < idString.length; i++) {
    hash = (hash << 5) - hash + idString.charCodeAt(i);
  }
  const views = Math.abs(hash % 380) + 120;
  const favs = Math.abs((hash >> 2) % 35) + 6;
  return { views, favs };
}

export default async function InfoDetailPage({ params }: PageProps) {
