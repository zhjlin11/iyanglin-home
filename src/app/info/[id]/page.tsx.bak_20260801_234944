                  {item.images.map((img, i) => (
                    <a key={i} href={img} target="_blank" rel="noreferrer">
                      <img 
                        src={img} 
                        alt={`${item.title} 图片 ${i + 1}`} 
                        style={{ width: "100%", height: "160px", objectFit: "cover", borderRadius: "var(--radius-md)", border: "1px solid var(--line)" }} 
                      />
                    </a>
                  ))}
                </div>
              </div>
            )}
          </article>

          {relatedListings.length > 0 && (
            <div style={{ marginTop: "32px" }}>
              <h3 style={{ fontSize: "18px", fontWeight: "800", marginBottom: "16px" }}>🔍 同类推荐便民信息</h3>
