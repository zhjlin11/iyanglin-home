            <div className="hero-title-group">
              <div style={{ display: "flex", gap: "8px", alignItems: "center", marginBottom: "6px" }}>
                <span className="eyebrow-tag">{categoryLabels[item.category || ""] || "本地信息"}</span>
                {isTop && <span className="pinned-badge">🔥 置顶推介</span>}
              </div>
              <h1>{item.title}</h1>

              <p style={{ display: "flex", gap: "16px", alignItems: "center", flexWrap: "wrap" }}>
                <span>📍 杨林本地</span>
                <span>📅 {formatPublishTime(item.createdAt)}</span>
                <span>👁️ 浏览 <b>{views}</b> 次</span>
                <span>❤️ 收藏 <b>{favs}</b> 人</span>
              </p>
            </div>
          </div>
        </div>
      </section>

      <section className="shell info-detail-layout">
        <div>
          <article className="info-detail-main">
            <DetailActions />

            <h2 style={{ fontSize: "18px", fontWeight: "700", marginBottom: "16px", color: "var(--ink)", paddingBottom: "8px", borderBottom: "1px solid var(--line)" }}>
              详细信息描述
            </h2>

            <div className="item-card-body" style={{ fontSize: "15px", whiteSpace: "pre-wrap", lineHeight: "1.7", color: "var(--ink-secondary)" }}>
              {stripHtml(item.body).split(/\n+/).map((paragraph, idx) => (
                <p key={idx} style={{ marginBottom: "12px" }}>{paragraph}</p>
              ))}
            </div>

            {item.images && item.images.length > 0 && (
